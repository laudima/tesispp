% define custom colors
\definecolor{MutedOrange}{rgb}{1.00, 0.971, 0.945}
\definecolor{MutedPurple}{rgb}{0.957, 0.937, 0.98}
\definecolor{MutedDeepPurple}{rgb}{0.94, 0.925, 0.98}
\definecolor{MutedBlack}{rgb}{0.95, 0.95, 0.95}

\definecolor{MediumOrange}{rgb}{1.00, 0.498, 0.165}
\definecolor{MediumPurple}{rgb}{0.467, 0.223, 0.596}
\definecolor{MediumDeepPurple}{rgb}{0.35, 0.15, 0.5}
\definecolor{MediumBlack}{rgb}{0.219, 0.259, 0.349}

\definecolor{Morado}{rgb}{0.47,0.22,0.6}

% set beamer color themes
\usecolortheme[named=Morado]{structure}

% customize colors for elements (using new color names)
\setbeamercolor{titlelike}{parent=structure}
\setbeamercolor{block title}{fg=white,bg=MediumDeepPurple}
\setbeamercolor{block body}{fg=black,bg=MutedDeepPurple}
\setbeamercolor{block title example}{fg=white,bg=MediumPurple}
\setbeamercolor{block body example}{fg=black,bg=MutedPurple}
\setbeamercolor{block title alerted}{fg=white,bg=MediumOrange}
\setbeamercolor{block body alerted}{fg=black,bg=MutedOrange}
