{
    "cSpell.words": [
        "acíclico",
        "Astorga",
        "butkus",
        "colisionador",
        "conceptualizaciones",
        "contrafactual",
        "correciones",
        "DGOAE",
        "Dimayuga",
        "Github",
        "Itzel",
        "mecanística",
        "networkx",
        "Schölkopf",
        "UNAM"
    ], 
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "/Library/TeX/texbin/latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-pdflatex=/Library/TeX/texbin/pdflatex %O %S",
                "-e",
                "$biber=\"/Library/TeX/texbin/biber %O %S\";",
                "-e",
                "$bibtex=\"/Library/TeX/texbin/bibtex %O %S\";",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.clean.command": "/Library/TeX/texbin/latexmk",
    "latex-workshop.latex.env": {
        "PATH": "/Library/TeX/texbin:${env:PATH}"
    }
}