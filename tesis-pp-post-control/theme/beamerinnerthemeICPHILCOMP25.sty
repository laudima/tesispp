\pgfdeclareverticalshading[lower.bg,upper.bg]{bmb@transition}{200cm}{color(0pt)=(lower.bg); color(2pt)=(lower.bg); color(4pt)=(lower.bg)}

\setbeamersize{text margin left=2em,text margin right=2em}

\setbeamertemplate{footline}[frame number]
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{enumerate subitem}[default]
\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{itemize subitem}[circle]

% table of contents (overview) settings
\setbeamertemplate{section in toc}[sections numbered]
\setbeamertemplate{subsection in toc}{%
    \leavevmode
    \leftskip=3.2em
    \rlap{\hskip-2em\inserttocsectionnumber.\inserttocsubsectionnumber}
    \inserttocsubsection\par
}

% frame title customization
\setbeamertemplate{frametitle}{%
    \vspace*{0.6em}
    \bfseries\insertframetitle\par
    \vskip-6pt
    \hrulefill\vspace{0.1em}
}

% title page customization
\setbeamertemplate{title page}{%
    \begingroup
    \noindent\hfill\inserttitlegraphic\par
    \vspace*{1em}
    \noindent\textcolor{white}{\rule{\textwidth}{1.2pt}}
    \vspace*{2em}
    % ------------------------
    \begin{beamercolorbox}[sep=10pt]{title}
                \usebeamerfont{title}\usebeamercolor[fg]{titlelike}\inserttitle\par%
        \ifx\insertsubtitle\@empty\else
          \vskip0.25em
                    {\usebeamerfont{subtitle}\usebeamercolor[fg]{titlelike}\insertsubtitle\par}%
        \fi
    \end{beamercolorbox}%
    \vskip0.2em\par
    % ------------------------
    \begin{beamercolorbox}[sep=8pt]{author}
        \usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor
    \end{beamercolorbox}
    \vskip0.2em
    % ------------------------
    \begin{beamercolorbox}[sep=8pt]{institute}
        \usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute
    \end{beamercolorbox}
    % ------------------------
    \begin{beamercolorbox}[sep=8pt]{date}
        \usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate
    \end{beamercolorbox}\vskip0.5em
    \vfill
  \endgroup
}
