% Monochrome palette for the post-control presentation.
\definecolor{MutedBlack}{rgb}{0.95, 0.95, 0.95}
\definecolor{MediumBlack}{rgb}{0.12, 0.12, 0.12}

% set beamer color themes
\usecolortheme[named=black]{structure}

% customize colors for elements (using new color names)
\setbeamercolor{normal text}{fg=white,bg=black}
\setbeamercolor{structure}{fg=white}
\setbeamercolor{background canvas}{fg=white,bg=black}
\setbeamercolor{titlelike}{fg=white,bg=black}
\setbeamercolor{block title}{fg=white,bg=black}
\setbeamercolor{block body}{fg=white,bg=black}
\setbeamercolor{block title example}{fg=white,bg=black}
\setbeamercolor{block body example}{fg=white,bg=black}
\setbeamercolor{block title alerted}{fg=white,bg=black}
\setbeamercolor{block body alerted}{fg=white,bg=black}
